<Window x:Class="VirtualSteerReceiver.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VirtualSteerReceiver.ViewModels"
        mc:Ignorable="d"
        Title="Virtual Steer Receiver - Diagnostics Dashboard" 
        Height="820" Width="1140"
        MinHeight="750" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        Icon="/Assets/logo.png">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Custom Styles & Brushes -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="CardBackground" Color="#1E293B" />
        <SolidColorBrush x:Key="CardBorder" Color="#334155" />
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6" />
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />

        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="6" />
        </Style>

        <Style TargetType="TextBlock" x:Key="HeaderLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>

        <Style TargetType="TextBlock" x:Key="StatValueText">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP BAR / HEADER -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True" Margin="0,0,12,0">
                        <Image Source="/Assets/logo.png" Stretch="Uniform" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="VIRTUAL STEER" FontSize="18" FontWeight="ExtraBold" Foreground="#F8FAFC" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Local IP: " FontSize="11" Foreground="{StaticResource TextMuted}" />
                            <TextBlock Text="{Binding LocalIpAddress}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Pairing Name: " FontSize="11" Foreground="{StaticResource TextMuted}" />
                            <TextBlock Text="{Binding HostDisplayName}" FontSize="11" FontWeight="Bold" Foreground="#FBBF24" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Controls & Status Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Port Config -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Port:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0" FontWeight="SemiBold" />
                        <Border CornerRadius="6" Background="#0F172A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                            <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="65" Padding="6,4" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Center" FontSize="13" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- Toggle Listening Button -->
                    <Button Command="{Binding ToggleListenCommand}" Padding="14,8" Margin="0,0,14,0" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="#2563EB" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <TextBlock x:Name="btnText" Text="Start Listening" Foreground="White" FontWeight="Bold" FontSize="13" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsListening}" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#DC2626" />
                                        <Setter TargetName="btnText" Property="Text" Value="Stop Listening" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 100Hz Test Stream Toggle Button -->
                    <Button Command="{Binding ToggleTestStreamCommand}" Padding="12,8" Margin="0,0,16,0" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="testBorder" Background="#475569" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="{Binding TestStreamButtonText}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsTestStreamRunning}" Value="True">
                                        <Setter TargetName="testBorder" Property="Background" Value="#D97706" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Toggle Diagnostics Button -->
                    <Button Command="{Binding ToggleDiagnosticsCommand}" Padding="12,8" Margin="0,0,16,0" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="diagBorder" Background="#475569" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <TextBlock x:Name="diagText" Text="📊 Show Diagnostics" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ShowDiagnostics}" Value="True">
                                        <Setter TargetName="diagBorder" Property="Background" Value="#2563EB" />
                                        <Setter TargetName="diagText" Property="Text" Value="📊 Hide Diagnostics" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Connection Status Badge -->
                    <Border CornerRadius="20" Padding="14,6" Background="{Binding ConnectionStatusBrush}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="White" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ConnectionStatusText}" Foreground="White" FontWeight="Bold" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- PAIRING PAGE / START CARD -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*" />
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="PAIR WITH MOBILE APP" Style="{StaticResource HeaderLabel}" />
                    <TextBlock Text="{Binding HostDisplayName}" FontSize="28" FontWeight="ExtraBold" Foreground="#F8FAFC" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding PairingStatusText}" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0">
                    <TextBlock Text="Receiver Name" Style="{StaticResource HeaderLabel}" Margin="0,0,0,6" />
                    <Border CornerRadius="6" Background="#0F172A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                        <TextBox Text="{Binding HostDisplayName, UpdateSourceTrigger=PropertyChanged}" Padding="10,7" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="14" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="{Binding DiscoveryPayloadPreview}" FontSize="11" Foreground="#64748B" FontFamily="Consolas" Margin="0,6,0,0" />
                    <TextBlock Text="Android can listen for this broadcast or send DISCOVER_VIRTUAL_STEER to UDP 4445." FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Discovery Port" Style="{StaticResource HeaderLabel}" />
                    <TextBlock Text="4445" Style="{StaticResource StatValueText}" Foreground="#38BDF8" />
                    <TextBlock Text="Controller Port" Style="{StaticResource HeaderLabel}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Port}" Style="{StaticResource StatValueText}" Foreground="#10B981" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MIDDLE CONTENT: DASHBOARD GRID -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: CONTROLLER INPUT GAUGES -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ANALOG AXES CARD -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid Margin="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="ANALOG CONTROLLER INPUTS" Style="{StaticResource HeaderLabel}" Margin="0,0,0,12" />

                        <!-- STEERING AXIS -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="STEERING: " Foreground="#94A3B8" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Text="{Binding SteeringDirectionText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" />
                                </StackPanel>
                                <TextBlock Text="{Binding SteeringText}" HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="ExtraBold" FontSize="15" />
                            </Grid>
                            <!-- Progress Bar representing Steering [-1.0 to 1.0] mapped to [0 to 100] -->
                            <Grid Grid.Row="1">
                                <ProgressBar Height="24" Value="{Binding SteeringGaugeValue, Mode=OneWay}" Minimum="0" Maximum="100" Background="#0F172A" Foreground="#38BDF8" BorderThickness="0"/>
                                <!-- Center Line Marker -->
                                <Border Width="2" Height="24" Background="#94A3B8" HorizontalAlignment="Center" Opacity="0.6"/>
                            </Grid>
                        </Grid>

                        <!-- THROTTLE AXIS -->
                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="THROTTLE" Foreground="#94A3B8" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="{Binding ThrottleText}" HorizontalAlignment="Right" Foreground="#10B981" FontWeight="ExtraBold" FontSize="15" />
                            </Grid>
                            <ProgressBar Grid.Row="1" Height="24" Value="{Binding ThrottleGaugeValue, Mode=OneWay}" Minimum="0" Maximum="100" Background="#0F172A" Foreground="#10B981" BorderThickness="0"/>
                        </Grid>

                        <!-- BRAKE AXIS -->
                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="BRAKE" Foreground="#94A3B8" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="{Binding BrakeText}" HorizontalAlignment="Right" Foreground="#EF4444" FontWeight="ExtraBold" FontSize="15" />
                            </Grid>
                            <ProgressBar Grid.Row="1" Height="24" Value="{Binding BrakeGaugeValue, Mode=OneWay}" Minimum="0" Maximum="100" Background="#0F172A" Foreground="#EF4444" BorderThickness="0"/>
                        </Grid>

                        <!-- CLUTCH AXIS -->
                        <Grid Grid.Row="4" Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="CLUTCH" Foreground="#94A3B8" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="{Binding ClutchText}" HorizontalAlignment="Right" Foreground="#F59E0B" FontWeight="ExtraBold" FontSize="15" />
                            </Grid>
                            <ProgressBar Grid.Row="1" Height="24" Value="{Binding ClutchGaugeValue, Mode=OneWay}" Minimum="0" Maximum="100" Background="#0F172A" Foreground="#F59E0B" BorderThickness="0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- DIGITAL BUTTONS GRID -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="BUTTON STATES" Style="{StaticResource HeaderLabel}" Margin="0,0,0,10" />
                        <UniformGrid Columns="4">

                            <!-- HANDBRAKE -->
                            <Border Margin="3" Padding="8" Background="#0F172A" CornerRadius="6">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Handbrake" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding HandbrakeText}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Handbrake}" Value="True">
                                                        <Setter Property="Foreground" Value="#EF4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- GEAR UP -->
                            <Border Margin="3" Padding="8" Background="#0F172A" CornerRadius="6">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Gear Up" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding GearUpText}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GearUp}" Value="True">
                                                        <Setter Property="Foreground" Value="#10B981" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- GEAR DOWN -->
                            <Border Margin="3" Padding="8" Background="#0F172A" CornerRadius="6">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Gear Down" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding GearDownText}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GearDown}" Value="True">
                                                        <Setter Property="Foreground" Value="#F59E0B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- PAUSE -->
                            <Border Margin="3" Padding="8" Background="#0F172A" CornerRadius="6">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Pause" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding PauseText}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Pause}" Value="True">
                                                        <Setter Property="Foreground" Value="#3B82F6" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- HORN -->
                            <Border Margin="3" Padding="8" Background="#0F172A" CornerRadius="6">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Horn" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding HornText}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Horn}" Value="True">
                                                        <Setter Property="Foreground" Value="#8B5CF6" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- CAMERA -->
                            <Border Margin="3" Padding="8" Background="#0F172A" CornerRadius="6">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Camera" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CameraText}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Camera}" Value="True">
                                                        <Setter Property="Foreground" Value="#EC4899" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- HEADLIGHTS -->
                            <Border Margin="3" Padding="8" Background="#0F172A" CornerRadius="6">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Headlights" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding HeadlightsText}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Headlights}" Value="True">
                                                        <Setter Property="Foreground" Value="#FBBF24" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- DPAD UP -->
                            <Border Margin="3" Padding="8" Background="#0F172A" CornerRadius="6">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Dpad Up" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding DpadUpText}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DpadUp}" Value="True">
                                                        <Setter Property="Foreground" Value="#38BDF8" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- DPAD DOWN -->
                            <Border Margin="3" Padding="8" Background="#0F172A" CornerRadius="6">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Dpad Down" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding DpadDownText}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DpadDown}" Value="True">
                                                        <Setter Property="Foreground" Value="#38BDF8" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- DPAD LEFT -->
                            <Border Margin="3" Padding="8" Background="#0F172A" CornerRadius="6">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Dpad Left" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding DpadLeftText}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DpadLeft}" Value="True">
                                                        <Setter Property="Foreground" Value="#38BDF8" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- DPAD RIGHT -->
                            <Border Margin="3" Padding="8" Background="#0F172A" CornerRadius="6">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Dpad Right" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding DpadRightText}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DpadRight}" Value="True">
                                                        <Setter Property="Foreground" Value="#38BDF8" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- BOOST (LB) -->
                            <Border Margin="3" Padding="8" Background="#0F172A" CornerRadius="6">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Boost (LB)" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding LBText}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LB}" Value="True">
                                                        <Setter Property="Foreground" Value="#10B981" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- REAR VIEW (RB) -->
                            <Border Margin="3" Padding="8" Background="#0F172A" CornerRadius="6">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Rear View (RB)" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding RBText}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RB}" Value="True">
                                                        <Setter Property="Foreground" Value="#10B981" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- RESET (BACK) -->
                            <Border Margin="3" Padding="8" Background="#0F172A" CornerRadius="6">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Reset (Back)" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding BackText}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Back}" Value="True">
                                                        <Setter Property="Foreground" Value="#EF4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RIGHT PANEL: ADVANCED NETWORK DIAGNOSTICS GRID -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Width="540" Visibility="{Binding ShowDiagnostics, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="NETWORK DIAGNOSTICS &amp; PERFORMANCE" Style="{StaticResource HeaderLabel}" Margin="0,0,0,12" />

                    <!-- 3-Column x 4-Row Stats Grid -->
                    <UniformGrid Grid.Row="1" Columns="3" Rows="4">

                        <!-- 1. Current Ping -->
                        <Border Margin="3" Background="#0F172A" CornerRadius="6" Padding="10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Current Ping" Style="{StaticResource HeaderLabel}" />
                                <TextBlock Text="{Binding CurrentPingText}" Style="{StaticResource StatValueText}" Foreground="#38BDF8"/>
                                <TextBlock Text="Real delta" FontSize="9" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <!-- 2. Average Ping -->
                        <Border Margin="3" Background="#0F172A" CornerRadius="6" Padding="10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Average Ping" Style="{StaticResource HeaderLabel}" />
                                <TextBlock Text="{Binding AveragePingText}" Style="{StaticResource StatValueText}" Foreground="#A855F7"/>
                                <TextBlock Text="Mean latency" FontSize="9" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <!-- 3. Maximum Ping -->
                        <Border Margin="3" Background="#0F172A" CornerRadius="6" Padding="10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Max Ping" Style="{StaticResource HeaderLabel}" />
                                <TextBlock Text="{Binding MaxPingText}" Style="{StaticResource StatValueText}" Foreground="#F59E0B"/>
                                <TextBlock Text="Peak spike" FontSize="9" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <!-- 4. Minimum Ping -->
                        <Border Margin="3" Background="#0F172A" CornerRadius="6" Padding="10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Min Ping" Style="{StaticResource HeaderLabel}" />
                                <TextBlock Text="{Binding MinPingText}" Style="{StaticResource StatValueText}" Foreground="#10B981"/>
                                <TextBlock Text="Best sample" FontSize="9" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <!-- 5. Jitter -->
                        <Border Margin="3" Background="#0F172A" CornerRadius="6" Padding="10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Jitter" Style="{StaticResource HeaderLabel}" />
                                <TextBlock Text="{Binding JitterText}" Style="{StaticResource StatValueText}" Foreground="#EC4899"/>
                                <TextBlock Text="RFC 3550 variance" FontSize="9" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <!-- 6. Bandwidth -->
                        <Border Margin="3" Background="#0F172A" CornerRadius="6" Padding="10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Bandwidth" Style="{StaticResource HeaderLabel}" />
                                <TextBlock Text="{Binding BandwidthText}" Style="{StaticResource StatValueText}" Foreground="#06B6D4"/>
                                <TextBlock Text="Throughput" FontSize="9" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <!-- 7. Bytes / sec -->
                        <Border Margin="3" Background="#0F172A" CornerRadius="6" Padding="10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Bytes / sec" Style="{StaticResource HeaderLabel}" />
                                <TextBlock Text="{Binding BytesPerSecondText}" Style="{StaticResource StatValueText}" Foreground="#3B82F6"/>
                                <TextBlock Text="Data rate" FontSize="9" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <!-- 8. Dropped Packets -->
                        <Border Margin="3" Background="#0F172A" CornerRadius="6" Padding="10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Dropped Packets" Style="{StaticResource HeaderLabel}" />
                                <TextBlock Text="{Binding DroppedPackets}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatValueText}">
                                            <Setter Property="Foreground" Value="#EF4444" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DroppedPackets}" Value="0">
                                                    <Setter Property="Foreground" Value="#10B981" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Sequence gap" FontSize="9" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <!-- 9. Reconnect Count -->
                        <Border Margin="3" Background="#0F172A" CornerRadius="6" Padding="10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Reconnect Count" Style="{StaticResource HeaderLabel}" />
                                <TextBlock Text="{Binding ReconnectCount}" Style="{StaticResource StatValueText}" Foreground="#6366F1"/>
                                <TextBlock Text="Session resumes" FontSize="9" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <!-- 10. Packets per second -->
                        <Border Margin="3" Background="#0F172A" CornerRadius="6" Padding="10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Packets / sec" Style="{StaticResource HeaderLabel}" />
                                <TextBlock Text="{Binding PacketsPerSecond}" Style="{StaticResource StatValueText}" Foreground="#10B981"/>
                                <TextBlock Text="Target: ~100 Hz" FontSize="9" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <!-- 11. Total Packets -->
                        <Border Margin="3" Background="#0F172A" CornerRadius="6" Padding="10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Total Packets" Style="{StaticResource HeaderLabel}" />
                                <TextBlock Text="{Binding TotalPackets}" Style="{StaticResource StatValueText}" Foreground="#F8FAFC"/>
                                <TextBlock Text="Processed" FontSize="9" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <!-- 12. CRC Failures -->
                        <Border Margin="3" Background="#0F172A" CornerRadius="6" Padding="10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="CRC Failures" Style="{StaticResource HeaderLabel}" />
                                <TextBlock Text="{Binding CrcFailures}" Style="{StaticResource StatValueText}" Foreground="#EF4444"/>
                                <TextBlock Text="Corrupted payloads" FontSize="9" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM CONSOLE: LOG FEED -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Height="180" Visibility="{Binding ShowDiagnostics, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="SYSTEM DIAGNOSTICS &amp; PACKET EVENT LOG" Style="{StaticResource HeaderLabel}" VerticalAlignment="Center"/>
                    <Button Command="{Binding ClearLogsCommand}" HorizontalAlignment="Right" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#334155" CornerRadius="4" Padding="10,4">
                                    <TextBlock Text="Clear Console" Foreground="White" FontSize="11" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" Background="#0F172A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Foreground="#CBD5E1" FontFamily="Consolas" FontSize="11" Padding="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="2">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#CBD5E1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                <Setter Property="Foreground" Value="#F59E0B" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                <Setter Property="Foreground" Value="#EF4444" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

    </Grid>
</Window>
